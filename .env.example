# ============================================================
# VERONICA BLOOM — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git!
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
NEXT_PUBLIC_APP_URL=https://veronica-bloom.vercel.app

# --- Paddle (Payment) ---
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=your-paddle-client-token
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_GLOW_METHOD_PRICE_ID=pri_xxxxx
NEXT_PUBLIC_PADDLE_ELITE_METHOD_PRICE_ID=pri_xxxxx
PADDLE_API_KEY=your-paddle-api-key
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxxxx

# --- LemonSqueezy (Legacy/Backup) ---
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-secret
LEMONSQUEEZY_STORE_ID=your-store-id
LEMONSQUEEZY_GLOW_VARIANT_ID=1013533
LEMONSQUEEZY_ELITE_VARIANT_ID=1013547

# --- Email (Resend) ---
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Veronica Bloom <noreply@yourdomain.com>

# --- Push Notifications (Web Push / VAPID) ---
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# --- Cron Jobs ---
CRON_SECRET=your-random-secret-for-cron-auth

# --- Analytics (optional) ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=veronica-bloom.vercel.app
